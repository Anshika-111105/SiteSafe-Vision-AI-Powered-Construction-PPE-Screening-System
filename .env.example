# SiteSafe Vision Environment Configuration Template
# Copy this file to .env and configure local values. Never commit .env to Git.

# Application Configuration
APP_NAME=SiteSafe Vision
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Model Configuration
MODEL_PATH=artifacts/models/production_model.pt
MODEL_METADATA_PATH=artifacts/models/model_metadata.json

# Storage / DVC Remote (Optional if using cloud storage)
# DVC_REMOTE_URL=s3://my-dvc-bucket/sitesafe-vision
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Roboflow Ingestion (Optional: if downloading live from Roboflow Universe)
# ROBOFLOW_API_KEY=
